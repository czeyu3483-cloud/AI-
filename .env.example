# DeepSeek（必填才能走真实 LLM；不填则自动 mock，Demo 仍可跑通）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 实时面试话术建议 disabled，降低延迟；复盘可在代码里单独开启
DEEPSEEK_THINKING=disabled

# 可选：TTS（不填则浏览器朗读 / 静音 mock）
# TTS_API_KEY=
# TTS_PROVIDER=none

# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3456
